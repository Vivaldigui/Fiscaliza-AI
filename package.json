{
  "name": "fiscaliza-ai",
  "version": "0.1.0",
  "private": true,
  "description": "Sistema interno auditável para fiscalização legislativa assistida por IA.",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @fiscaliza/database db:generate",
    "db:migrate": "pnpm --filter @fiscaliza/database db:migrate",
    "db:deploy": "pnpm --filter @fiscaliza/database db:deploy",
    "db:seed": "pnpm --filter @fiscaliza/database db:seed"
  },
  "devDependencies": {
    "@eslint/js": "9.32.0",
    "@types/node": "24.2.1",
    "eslint": "9.32.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "16.3.0",
    "prettier": "3.6.2",
    "turbo": "2.5.6",
    "typescript": "5.9.2",
    "typescript-eslint": "8.39.0"
  }
}
