{
  "name": "Fiscaliza AI - Alerta de prazo (referência de entrega)",
  "active": false,
  "nodes": [
    {
      "name": "Backend Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0],
      "parameters": {
        "httpMethod": "POST",
        "path": "fiscaliza/notification-delivery",
        "responseMode": "lastNode",
        "options": {
          "includeHeaders": true
        }
      }
    },
    {
      "name": "Filtrar alertas de prazo",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [280, 0],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true },
          "conditions": [
            {
              "leftValue": "={{ $('Backend Webhook').first().json.notificationType ?? $json.notificationType }}",
              "rightValue": "DEADLINE_APPROACHING",
              "type": "string",
              "operation": "equals"
            }
          ]
        }
      }
    },
    {
      "name": "Entrega consolidada",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 2.3,
      "position": [560, 0],
      "parameters": {
        "workflowId": "notification-delivery"
      }
    }
  ],
  "connections": {
    "Backend Webhook": {
      "main": [[{ "node": "Filtrar alertas de prazo", "type": "main", "index": 0 }]]
    },
    "Filtrar alertas de prazo": {
      "main": [
        [
          {
            "node": "Entrega consolidada",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": { "executionOrder": "v1" }
}
