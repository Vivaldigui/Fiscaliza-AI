# Ambiente
NODE_ENV=development
API_PORT=3001
WEB_PORT=3000
APP_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
LOG_LEVEL=info
ENABLE_SWAGGER=true

# PostgreSQL (troque todos os placeholders fora do desenvolvimento local)
POSTGRES_DB=fiscaliza
POSTGRES_USER=fiscaliza
POSTGRES_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
DATABASE_URL=postgresql://fiscaliza:CHANGE_ME_DATABASE_PASSWORD@postgres:5432/fiscaliza?schema=public

# Redis
REDIS_URL=redis://redis:6379

# MinIO / S3
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=fiscaliza-local
MINIO_SECRET_KEY=CHANGE_ME_MINIO_SECRET
MINIO_BUCKET=fiscaliza-documents
MINIO_REGION=us-east-1
MINIO_PUBLIC_ENDPOINT=http://localhost:9000

# Autenticação
JWT_ACCESS_SECRET=CHANGE_ME_WITH_AT_LEAST_32_RANDOM_CHARACTERS
JWT_ACCESS_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
COOKIE_SECURE=false
COOKIE_DOMAIN=

# Bootstrap opcional. Defina ambos apenas na primeira inicialização.
SEED_ADMIN_EMAIL=admin@example.invalid
SEED_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD_12_CHARS
SEED_ADMIN_NAME=Administrador inicial

# Upload e processamento
DOCUMENT_INBOX_PATH=/data/inbox
DOCUMENT_UPLOAD_TEMP_PATH=/data/uploads
DOCUMENT_MAX_SIZE_MB=25
DOCUMENT_MAX_PAGES=500
DOCUMENT_PROCESSING_TIMEOUT=300000
DOCUMENT_WATCHER_ENABLED=true
DOCUMENT_WATCHER_STABILITY_MS=5000
DOCUMENT_WATCHER_POLL_INTERVAL_MS=500
DOCUMENT_ANTIVIRUS_ENABLED=true
DOCUMENT_ANTIVIRUS_REQUIRED=true
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=120000
DOCUMENT_OCR_ENABLED=true
DOCUMENT_OCR_LANGUAGES=por
DOCUMENT_OCR_CONCURRENCY=1
DOCUMENT_OCR_TIMEOUT_MS=120000
DOCUMENT_TEXT_MIN_CHARACTERS=80
DOCUMENT_TEXT_MIN_WORDS=8
DOCUMENT_TEXT_MIN_QUALITY=0.55
DOCUMENT_CHUNK_SIZE=1200
DOCUMENT_CHUNK_OVERLAP=150
SIGNED_URL_TTL_SECONDS=300
DOCUMENT_QUEUE_ATTEMPTS=3
DOCUMENT_QUEUE_BACKOFF_MS=5000
DOCUMENT_WORKER_CONCURRENCY=2
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=20
WORKER_HEALTH_PORT=3002
DEADLINE_SWEEP_INTERVAL_MS=3600000

# IA (Fase 4: extração, análise item a item e resumo executivo)
# AI_PROCESSING_ENABLED começa desabilitada por padrão (fail closed). Uma
# solicitação de análise falha de forma clara e recuperável enquanto estiver
# false; nenhum PDF é enviado a um provider externo até ativação explícita.
AI_PROCESSING_ENABLED=false
# LLM_PROVIDER aceita anthropic, openai (chave GPT) ou fake (dev/CI).
LLM_PROVIDER=fake
# LLM_MODEL: deixe vazio para fake. Ex. de modelos reais: gpt-4o,
# gpt-4.1, gpt-5 (openai); claude-* (anthropic).
LLM_MODEL=
# Chave do provider escolhido em LLM_PROVIDER (ex.: sk-... para openai).
LLM_API_KEY=
AI_REQUEST_TIMEOUT_MS=60000
AI_MAX_RETRIES=2
AI_JOB_CONCURRENCY=1
AI_MAX_PAGES_PER_BATCH=20
AI_MAX_INPUT_CHARS=60000
AI_QUEUE_ATTEMPTS=3
AI_QUEUE_BACKOFF_MS=10000

# Embeddings (Fase 5A: indexação pgvector e retrieval autorizado)
# A indexação é incremental, versionada (provider/modelo/versão/hash) e
# idempotente; reprocessar nunca reescreve o histórico. EMBEDDINGS_ENABLED
# começa false (fail closed): nenhum chunk sai sem ativação explícita.
EMBEDDINGS_ENABLED=false
# EMBEDDINGS_PROVIDER aceita openai ou fake. fake é rejeitado em produção.
EMBEDDINGS_PROVIDER=fake
EMBEDDINGS_MODEL=text-embedding-3-small
EMBEDDINGS_DIMENSION=1536
# Chave do provider em EMBEDDINGS_PROVIDER (ex.: sk-... para openai).
EMBEDDINGS_API_KEY=
EMBEDDINGS_TIMEOUT_MS=30000
EMBEDDINGS_BATCH_SIZE=16
EMBEDDINGS_QUEUE_ATTEMPTS=3
EMBEDDINGS_QUEUE_BACKOFF_MS=10000
EMBEDDINGS_WORKER_CONCURRENCY=1

# Conversa web (Fase 5A: RAG autorizado com fontes)
# CHAT_ENABLED exige AI_PROCESSING_ENABLED=true e EMBEDDINGS_ENABLED=true.
CHAT_ENABLED=false
CHAT_WORKER_CONCURRENCY=1
CONVERSATION_SESSION_TTL_SECONDS=1800
CONVERSATION_RAG_TOP_K=8
CONVERSATION_MAX_CONTEXT_CHARS=60000
CONVERSATION_ANSWER_MAX_RETRIES=2
CONVERSATION_QUEUE_ATTEMPTS=3
CONVERSATION_QUEUE_BACKOFF_MS=10000

# Integrações (não exponha ao frontend)
N8N_WEBHOOK_BASE_URL=
N8N_WEBHOOK_SECRET=
UAZAPI_BASE_URL=
UAZAPI_TOKEN=
